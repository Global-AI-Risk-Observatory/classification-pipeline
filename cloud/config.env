# Google Cloud configuration of the pipeline. Not secret; secrets go to Secret Manager.
GCP_PROJECT=gario-1
GCP_REGION=us-central1
GCS_BUCKET_RAW=airo-filings-raw
GCS_BUCKET_DATA=airo-pipeline-data
PIPELINE_SERVICE_ACCOUNT=airo-pipeline@gario-1.iam.gserviceaccount.com
GEMINI_MODEL=gemini-3.8-flash
ARTIFACT_IMAGE=us-central1-docker.pkg.dev/gario-1/airo/pipeline
CLOUD_BUILD_TRIGGER=airo-main
CLOUD_BUILD_SERVICE_ACCOUNT=cloudbuild-airo@gario-1.iam.gserviceaccount.com
