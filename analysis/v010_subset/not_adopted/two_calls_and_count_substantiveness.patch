+def test_codebook_has_a_variant_per_call_and_the_single_variant_holds_both():
+    single, roles, details = (taxonomy.codebook(s) for s in ("single", "roles", "details"))
+    assert taxonomy.codebook() == single
+    assert "roles call" in roles and "(`roles`)" in roles and "(`ai_reference`)" in roles
+    for field in ("risk_types", "mit_subdomains", "adoption_stage", "business_functions", "governance_responses",
+                  "ai_kinds", "disclosure_traits", "substantiveness_particulars"):
+        assert f"(`{field}`)" not in roles, field
+        assert f"(`{field}`)" in details and f"(`{field}`)" in single, field
+    assert "details call" in details and "(`roles`)" not in details
+    assert "do not return them" in details  # the given fields are not judged again
+    assert "- `risk`: " in details  # the roles are listed for reference
+    assert len(roles) < len(details) < len(single)
+
+
+def test_roles_label_applies_the_roles_rules_and_nothing_else():
+    ok = taxonomy.RolesLabel(passage_id=P1, ai_reference="explicit", roles=["adoption"],
+                             evidence=["we use AI", "a", "b", "c"], confidence="high")
+    assert ok.evidence == ["we use AI", "a", "b"]  # cut to three, as for a complete label
+    assert set(ok.model_dump()) == set(taxonomy.ROLES_FIELDS)
+    none = taxonomy.RolesLabel(passage_id=P1, ai_reference="none", confidence="low")
+    assert none.roles == []
+    for bad, match in (
+        (dict(ai_reference="explicit", evidence=["x"]), "at least one role"),
+        (dict(ai_reference="explicit", roles=["general", "risk"], evidence=["x"]), "general"),
+        (dict(ai_reference="explicit", roles=["risk"]), "evidence is required"),
+        (dict(ai_reference="none", roles=["risk"]), "must leave all other label fields empty"),
+    ):
+        with pytest.raises(ValidationError, match=match):
+            taxonomy.RolesLabel(passage_id=P1, confidence="high", **bad)
+
+
+def test_merge_joins_the_two_answers_into_a_label_that_passes_the_complete_check():
+    roles = taxonomy.RolesLabel(passage_id=P1, ai_reference="explicit", roles=["risk"],
+                                evidence=["AI may fail"], confidence="high", note="roles note").model_dump()
+    details = {"passage_id": P1, "risk_types": ["operational_reliability"], "mit_subdomains": ["lack_of_capability_robustness"],
+               "ai_kinds": ["unspecified"], "disclosure_traits": ["hedging"], "substantiveness_particulars": ["named_system"],
+               "entities": ["Acme Model"], "evidence": ["AI may fail", "the Acme Model"], "confidence": "medium", "note": "details note"}
+    merged = taxonomy.merge(roles, details)
+    label = Label.model_validate(merged)
+    assert label.roles == ["risk"] and label.risk_types == ["operational_reliability"] and label.entities == ["Acme Model"]
+    assert label.evidence == ["AI may fail", "the Acme Model"]  # the same quote once
+    assert label.confidence == "medium" and label.note == "roles note details note"
+    assert (label.substantiveness, label.substantiveness_score) == ("company_specific", 1)
+    # The details answer cannot overrule the roles call.
+    assert Label.model_validate(taxonomy.merge(roles, {**details, "roles": ["adoption"], "ai_reference": "none"})).roles == ["risk"]
+    # A `none` roles label needs no details.
+    none = taxonomy.merge(taxonomy.RolesLabel(passage_id=P2, ai_reference="none", confidence="high").model_dump(), None)
+    assert Label.model_validate(none).ai_reference == "none"
+    with pytest.raises(ValueError, match="merged with roles for"):
+        taxonomy.merge(roles, {**details, "passage_id": P2})
+
