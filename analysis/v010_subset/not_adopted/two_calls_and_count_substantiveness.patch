+    assert [r["ai_reference"] for r in roles_rows] == ["explicit", "none", "explicit"] and "ai_kinds" not in roles_rows[0]
+    assert json.loads((tmp_path / "roles.jsonl.run.json").read_text())["stage"] == "roles"
+    assert "--stage details --roles-from" in capsys.readouterr().out
+
+    rc = gemini.main(["--tasks", str(tasks_file), "--codebook", str(tmp_path / "codebook_details.md"), "--out", str(out),
+                      "--model", "cheap-model", "--project", "cheap", "--stage", "details", "--roles-from", str(roles_out),
+                      "--batch-size", "1"])
+    assert rc == 0
+    rows = [json.loads(l) for l in out.read_text(encoding="utf-8").splitlines()]
+    assert len(rows) == 3 and len(clients["cheap"].models.calls) == 2
+    assert classify.validate([json.dumps(r) for r in rows], TASKS, "gemini")[1] == []
+    summary = json.loads((tmp_path / "gemini.jsonl.run.json").read_text())
+    assert (summary["stage"], summary["model"], summary["without_call"]) == ("details", "cheap-model", 1)
+    assert "accept" in capsys.readouterr().out
