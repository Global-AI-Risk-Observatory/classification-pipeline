+def revisions(spreadsheet_id: str, project: str) -> list[dict]:
+    """The spreadsheet's revisions from the Drive API: who saved when. Google merges edits made
+    within a short time into one revision, so a revision is a stretch of work, not a cell."""
+    url = f"https://www.googleapis.com/drive/v3/files/{spreadsheet_id}/revisions?pageSize=1000&fields=nextPageToken,revisions(id,modifiedTime,lastModifyingUser(emailAddress))"
+    out, token_ = [], None
+    while True:
+        got = api("GET", url + (f"&pageToken={token_}" if token_ else ""), project)
+        out += got.get("revisions", [])
+        token_ = got.get("nextPageToken")
+        if not token_:
+            return out
+
+
+def activity(sheets_meta: dict, project: str, created_by: str) -> dict:
+    """Per rater: the revisions after the sheet was set up, by editor, with first and last time."""
+    out = {}
+    for k, meta in sheets_meta.items():
+        revs = [r for r in revisions(meta["spreadsheetId"], project)]
+        setup = [r for r in revs if r.get("lastModifyingUser", {}).get("emailAddress") == created_by][:3]
+        edits = [r for r in revs if r not in setup]
+        by_editor = Counter(r.get("lastModifyingUser", {}).get("emailAddress") or "anonymous" for r in edits)
+        times = sorted(r["modifiedTime"] for r in edits)
+        by_hour = Counter(t[:13] for t in times)
+        out[k] = {"revisions": len(edits), "first": times[0] if times else None, "last": times[-1] if times else None,
+                  "editors": dict(by_editor), "revisions_per_hour": dict(sorted(by_hour.items()))}
+    return out
+
+
