+    for name in ("codebook_roles.md", "codebook_details.md"):
+        (tmp_path / name).write_text(f"# {name}\n", encoding="utf-8")
+    roles_out, out = tmp_path / "roles.jsonl", tmp_path / "gemini.jsonl"
+    clients = {"strong": FakeClient(lambda pid, n: FakeResponse(json.dumps(roles_answer(pid)))),
+               "cheap": FakeClient(lambda pid, n: FakeResponse(json.dumps(details_answer(pid))))}
+    monkeypatch.setattr(gemini, "make_client", lambda project, location: clients[project])
+
+    with pytest.raises(SystemExit):  # --roles-from is required with --stage details
